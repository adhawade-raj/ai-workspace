     "text": [
      "--- Normal Indexing ---\n",
      "1\n",
      "---Fancy Indexing---\n",
      "[1 2 3]\n",
      "--- Boolean indexing---\n",
      "[3 4 5 6]\n"
     ]
    }
   ],
   "source": [
    "arr = np.array([[1,2,3], [4,5,6]])\n",
    "print(\"--- Normal Indexing ---\")\n",
    "print(arr[0][0])\n",
    "\n",
    "\n",
    "arr2 = np.array([1,2,3,4,5,6])\n",
    "print(\"---Fancy Indexing---\")\n",
    "idx = [0,1,2]\n",
    "print(arr2[idx])\n",
    "\n",
    "print(\"--- Boolean indexing---\")\n",
    "print(arr2[arr2 > 2])\n"
   ]
  }
 ],
